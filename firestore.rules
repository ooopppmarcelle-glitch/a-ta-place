rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Private profile document: never expose email or device token publicly.
    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'displayName','username','email','photoURL','bio','language',
          'pushEnabled','createdAt'
        ]);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','photoURL','bio','language','fcmToken','pushEnabled'
        ]);
      allow delete: if owns(uid);

      // Notification records are created by trusted server code only.
      match /notifications/{notificationId} {
        allow read: if owns(uid);
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }
    }

    // Username reservation used to prevent duplicate public handles.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}